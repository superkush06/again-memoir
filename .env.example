# Local-only configuration template. Copy to .env and keep that file private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
# Our own Actor in actors/google-photos-album, after `npx apify-cli push` (username/google-photos-shared-album).
APIFY_GOOGLE_PHOTOS_ACTOR=
# Choose a compatible actor and input template; see docs/integrations.md.
APIFY_LINKEDIN_ACTOR=
APIFY_LINKEDIN_INPUT_TEMPLATE=
APIFY_YOUTUBE_ACTOR=
APIFY_YOUTUBE_INPUT_TEMPLATE=
APIFY_MAX_CHARGE_USD=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI in the Google OAuth web client.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback
APP_ORIGIN=http://localhost:5173

VITE_SPACETIMEDB_URL=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DATABASE=vr-mutliplayer-memoir-naxot
PORT=3001
# Depth Anything V2 device. auto (default): WebGPU with CPU fallback on macOS, CPU elsewhere.
# webgpu: prefer WebGPU on any platform, falling back to CPU. cpu: always CPU.
# Measure before opting in on Windows/Linux: see docs/m5-results.md.
DEPTH_DEVICE=auto
API_PORT=3001
WEB_PORT=5173
# Optional absolute ffmpeg executable path for video-frame reconstruction.
FFMPEG_PATH=
# Optional Python 3.11 environment for local automatic human pose fitting.
# See docs/automatic-human-poses.md; defaults to .venv-pose when available.
POSE_PYTHON_PATH=
# heavy improves occluded/crowded poses; full uses less CPU time.
POSE_MODEL_VARIANT=heavy
# Optional device-trusted HTTPS certificate paths for Vite (not self-signed bypass).
TLS_CERT=
TLS_KEY=
