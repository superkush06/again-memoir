{
  "name": "again-memoir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts src/multiplayer/*.test.ts src/scene/*.test.ts actors/google-photos-album/test/*.test.js",
    "test:3d": "tsx --test server/geometry-contract.test.ts server/depth-readiness.test.ts src/scene/*.test.ts",
    "test:3d:simulate": "tsx scripts/3d-simulate.ts",
    "test:3d:full-simulate": "tsx scripts/3d-full-simulate.ts",
    "test:3d:live": "tsx scripts/3d-live-check.ts",
    "benchmark:3d": "tsx scripts/benchmark-3d.ts",
    "benchmark:3d:compare": "tsx scripts/m5/compare-models.ts",
    "test:multiplayer": "npm --prefix spacetimedb test",
    "test:live": "tsx src/multiplayer/live-smoke.ts",
    "reconstruct": "tsx scripts/reconstruct-library.ts",
    "readiness:report": "tsx scripts/readiness-report.ts",
    "neural:import": "tsx scripts/import-neural-asset.ts",
    "vr:devices": "node scripts/quest-deploy.mjs devices",
    "vr:check": "node scripts/quest-deploy.mjs check",
    "vr:deploy": "npm run build && node scripts/quest-deploy.mjs deploy",
    "vr:dev": "node scripts/quest-deploy.mjs deploy --port 5173",
    "test:vr": "node --test scripts/quest-deploy.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@huggingface/transformers": "^4.3.1",
    "apify-client": "^2.25.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "spacetimedb": "^2.13.0",
    "three": "^0.180.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
